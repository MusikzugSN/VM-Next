{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "vm",
  "sourceRoot": "apps/web/src",
  "tags": [],
  "targets": {
    "licenses": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/pnpm-lock.yaml",
        "{projectRoot}/scripts/generate-dependencies.mjs"
      ],
      "outputs": [
        "{workspaceRoot}/dist/generated/web"
      ],
      "options": {
        "command": "node apps/web/scripts/generate-dependencies.mjs dist/generated/web/dependencies.json"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/web",
        "browser": "apps/web/src/main.ts",
        "tsConfig": "apps/web/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/public"
          },
          {
            "glob": "pdf.worker.min.mjs",
            "input": "node_modules/pdfjs-dist/build",
            "output": "pdfjs"
          },
          {
            "glob": "*.{wasm,js}",
            "input": "node_modules/pdfjs-dist/wasm",
            "output": "pdfjs/wasm",
            "ignore": [
              "quickjs-eval.*"
            ]
          },
          {
            "glob": "*",
            "input": "node_modules/pdfjs-dist/standard_fonts",
            "output": "pdfjs/standard_fonts"
          },
          {
            "glob": "*",
            "input": "node_modules/pdfjs-dist/cmaps",
            "output": "pdfjs/cmaps"
          },
          {
            "glob": "dependencies.json",
            "input": "dist/generated/web",
            "output": "/"
          }
        ],
        "styles": [
          "apps/web/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "700kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "dependsOn": [
        "^build",
        "licenses"
      ]
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "web:build:production"
        },
        "development": {
          "buildTarget": "web:build:development"
        }
      },
      "dependsOn": [
        "api:serve",
        "licenses"
      ],
      "options": {
        "proxyConfig": "apps/web/proxy.conf.json"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false,
        "setupFiles": [
          "apps/web/src/test-setup.ts"
        ]
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": [
        "build"
      ],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "web:build",
        "staticFilePath": "dist/apps/web/browser",
        "spa": true
      }
    }
  }
}
