# Copy to apps/api/.env for local development (see apps/api/README.md).
# Every variable is validated at startup (apps/api/src/config/env.schema.ts).

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Set to true behind the club's reverse proxy (X-Forwarded-* headers)
TRUST_PROXY=false
# error | warn | log | debug | verbose
LOG_LEVEL=log
# Time zone of the club (when do events count as past)
APP_TIMEZONE=Europe/Berlin

# Browser-facing address of VM-Web (Angular dev server in development)
PUBLIC_BASE_URL=http://localhost:4200

# MySQL from docker-compose.dev.yml
DATABASE_URL=mysql://vmweb:vmweb@localhost:3307/vmweb
DB_MIGRATE_ON_START=true

# Directory for PDFs and logo (created automatically; ignored by git)
FILE_STORAGE_PATH=./tmp/storage
UPLOAD_MAX_FILE_MB=50

# OIDC client from Pocket ID (docker-compose.dev.yml), see README
OIDC_ISSUER_URL=http://localhost:1411
OIDC_CLIENT_ID=change-me
# Leave empty for a public client (PKCE only)
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email

SESSION_IDLE_TTL_DAYS=14
SESSION_ABSOLUTE_TTL_DAYS=90
