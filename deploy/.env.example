# Copy to deploy/.env and fill in. Used by deploy/docker-compose.yml.

# --- Images -----------------------------------------------------------------------------------------
# Registry path of the images (without tag) and the release to run, e.g. 1.2.0
VM_NEXT_API_IMAGE=ghcr.io/musikzugsn/vm-next-api
VM_NEXT_WEB_IMAGE=ghcr.io/musikzugsn/vm-next-web
VM_NEXT_VERSION=latest

# --- Network ----------------------------------------------------------------------------------------
# Where the web container listens on the host; point the club's reverse proxy here.
# Use 0.0.0.0 if the reverse proxy runs on another machine.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Browser-facing address of VM-Next (as entered in the reverse proxy), e.g. https://noten.example.org
PUBLIC_BASE_URL=

# --- Database ---------------------------------------------------------------------------------------
# Long random value, e.g. `openssl rand -hex 32`
POSTGRES_PASSWORD=

# --- Login (OIDC, e.g. Pocket ID) -------------------------------------------------------------------
# Redirect URI to register at the identity server: <PUBLIC_BASE_URL>/internal/v1/auth/callback
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# Leave empty for a public client (PKCE only)
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email

# --- Optional ---------------------------------------------------------------------------------------
APP_TIMEZONE=Europe/Berlin
# error | warn | log | debug | verbose
LOG_LEVEL=log
UPLOAD_MAX_FILE_MB=50
# must be a bit larger than UPLOAD_MAX_FILE_MB
CLIENT_MAX_BODY_SIZE=60m
SESSION_IDLE_TTL_DAYS=14
SESSION_ABSOLUTE_TTL_DAYS=90
