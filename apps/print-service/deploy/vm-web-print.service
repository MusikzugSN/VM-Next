# systemd user unit for the VM-Web Druckservice (Linux, CUPS). Installed by install.sh:
#   ~/.local/bin/vm-web-print (single executable, no Node.js needed)
#   ~/.config/systemd/user/vm-web-print.service
[Unit]
Description=VM-Web Druckservice
After=network.target cups.service

[Service]
ExecStart=%h/.local/bin/vm-web-print
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
