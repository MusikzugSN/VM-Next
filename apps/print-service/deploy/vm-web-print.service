# systemd user unit for the VM-Web Druckservice (Linux, CUPS).
# Install:  cp vm-web-print.service ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now vm-web-print
[Unit]
Description=VM-Web Druckservice
After=network.target cups.service

[Service]
ExecStart=/usr/bin/env node %h/.local/lib/vm-web-print/main.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
