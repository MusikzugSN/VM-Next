{
  "browser": {
    "browserName": "chromium",
    "isolated": false,
    "userDataDir": "/var/lib/vm-e2e/profiles/admin",
    "launchOptions": {
      "headless": false,
      "args": ["--kiosk-printing", "--lang=de-DE"]
    },
    "contextOptions": {
      "viewport": { "width": 1440, "height": 900 },
      "locale": "de-DE",
      "timezoneId": "Europe/Berlin",
      "acceptDownloads": true
    }
  },
  "sharedBrowserContext": true,
  "server": { "port": 8931, "host": "0.0.0.0", "allowedHosts": ["*"] },
  "outputDir": "/out/downloads/admin",
  "filePaths": "absolute",
  "allowUnrestrictedFileAccess": true,
  "console": { "level": "warning" },
  "timeouts": { "action": 10000, "navigation": 60000 }
}
