{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/src",
  "projectType": "library",
  "prefix": "vm",
  "tags": [],
  "targets": {
    "test-build": {
      "executor": "@angular/build:application",
      "options": {
        "browser": "libs/ui/src/index.ts",
        "tsConfig": "libs/ui/tsconfig.spec.json",
        "outputPath": "dist/libs/ui-test",
        "optimization": false,
        "sourceMap": true
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "ui:test-build",
        "tsConfig": "libs/ui/tsconfig.spec.json",
        "watch": false
      }
    }
  }
}
